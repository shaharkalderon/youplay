# Cross-device sync (optional). Without these the app runs local-only.
# Both values are safe to publish: the anon key only grants what your row level
# security policies allow, which is "your own row and nothing else".
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# The New feed (optional). A YouTube Data API v3 key. It ships in the public
# bundle, so restrict it in Google Cloud: Websites -> your site and
# http://localhost:5173/*, and API restrictions -> YouTube Data API v3 only.
VITE_YOUTUBE_API_KEY=YOUR-YOUTUBE-API-KEY
